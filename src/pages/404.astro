---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/site';

const site = await getSite();
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Not found | ${site.title}`} description="That page does not exist." />
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>404</h1>
				<div class="sys">
					<div class="sys-head"><span>! Warning</span><span class="dim">Gate not found</span></div>
					<p class="lede">That page doesn't exist.</p>
				<p>
					Try the <a href="/projects">projects</a> or the <a href="/blog">blog</a>, or head
					<a href="/">home</a>.
					</p>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
