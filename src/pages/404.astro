---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Not found | ${SITE_TITLE}`} description="That page does not exist." />
	</head>
	<body>
		<Header />
		<main>
			<h1>404</h1>
			<p>That page doesn't exist.</p>
			<p>
				Try the <a href="/projects">projects</a> or the <a href="/blog">blog</a>, or head
				<a href="/">home</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>
