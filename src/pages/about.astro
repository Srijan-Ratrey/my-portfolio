---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { byOrder, getSite } from '../lib/site';

// Roles come from src/content/experience/*.md, one file per role, ordered by their
// `order` field via byOrder. Everything else on this page comes from src/content/pages/about.md
// — education, skills and certificates from its frontmatter, the narrative from
// its body.
const site = await getSite();

const pages = await getCollection('pages');
const about = pages.find((p) => p.id === 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
const { heading, lede, description, education, skills = [], certificates = [] } = about.data;

const roles = (await getCollection('experience')).sort(byOrder);

// Skills are a comma list per group; an item may carry a self-assessed rank
// suffix, "Python (S)". Ranked items get the letter and a mana bar, unranked
// ones just the name — no rank is ever invented here.
const RANK_PCT: Record<string, number> = { S: 95, A: 82, B: 70, C: 55, D: 40, E: 25 };
const parseSkills = (items: string) =>
	items
		.split(',')
		.map((s) => s.trim())
		.filter(Boolean)
		.map((s) => {
			const m = s.match(/^(.*?)\s*\(([SABCDE])\)$/i);
			return m ? { name: m[1], rank: m[2].toUpperCase() } : { name: s, rank: undefined };
		});
// Decorative kanji per group, cycled: power, knowledge, speed, fortune, magic, art.
const KANJI = ['力', '知', '速', '運', '魔', '術'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${site.title}`} description={description ?? site.description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>{heading}</h1>
				<p class="lede">{lede}</p>
				<div class="prose-body"><Content /></div>
			</div>

			{
				roles.length > 0 && (
					<section class="sys block" style="--i:0">
						<h2 class="sys-head">Experience</h2>
						<ol class="roles">
							{roles.map((role) => (
								<li class="role">
									<div class="role-head">
										<div>
											<h3>{role.data.title}</h3>
											<p class="org">
												{role.data.org} · {role.data.location}
											</p>
										</div>
										<span class="period">{role.data.period}</span>
									</div>
									<ul class="bullets">
										{role.data.bullets.map((b) => (
											<li>{b}</li>
										))}
									</ul>
								</li>
							))}
						</ol>
					</section>
				)
			}

			{
				education && (
					<section class="sys block" style="--i:1">
						<h2 class="sys-head">Education</h2>
						<div class="role-head">
							<div>
								<h3>{education.degree}</h3>
								<p class="org">{education.school}</p>
							</div>
							<span class="period">{education.period}</span>
						</div>
					</section>
				)
			}

			{
				skills.length > 0 && (
					<section class="block stats">
						<h2 class="stats-title">
							<span class="br">[</span> Hunter Stats <span class="br">]</span>
						</h2>
						<div class="stat-grid">
							{skills.map((s, i) => (
								<div class="sys stat-card" style={`--i:${i}`}>
									<h3>
										<span class="kanji" aria-hidden="true">
											{KANJI[i % KANJI.length]}
										</span>
										{s.group}
									</h3>
									<ul>
										{parseSkills(s.items).map((it) => (
											<li>
												<span class="name">{it.name}</span>
												{it.rank && (
													<>
														<span class={`rank r-${it.rank}`}>{it.rank}</span>
														<span
															class="bar"
															style={`--p:${RANK_PCT[it.rank]}%`}
															aria-hidden="true"
														/>
													</>
												)}
											</li>
										))}
									</ul>
								</div>
							))}
						</div>
					</section>
				)
			}

			{
				certificates.length > 0 && (
					<section class="sys block" style="--i:3">
						<h2 class="sys-head">Certificates</h2>
						<ul class="plain">
							{certificates.map((c) => (
								<li>{c}</li>
							))}
						</ul>
					</section>
				)
			}

			<section class="sys block" style="--i:4">
				<h2 class="sys-head">Elsewhere</h2>
				<ul class="plain links">
					<li>
						<a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
					</li>
					<li>
						<a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
					</li>
					<li>
						<a href="https://huggingface.co/srijanratrey" target="_blank" rel="noopener">
							Hugging Face ↗
						</a>
					</li>
					<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede {
		font-size: 19px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin-top: 1.25rem;
	}

	/* Markdown body from about.md. :global because <Content /> output isn't scoped. */
	.prose-body :global(p) {
		margin-bottom: 1em;
	}
	.prose-body :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.block {
		margin-top: 2.5rem;
	}
	.block .sys-head {
		margin-bottom: 0;
	}

	.roles {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.role {
		padding: 2rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.roles > li:last-child {
		border-bottom: none;
	}
	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1.5rem 0 0;
	}
	.role .role-head {
		padding-top: 0;
	}
	.role-head h3 {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 700;
		letter-spacing: 0.01em;
	}
	.org {
		margin: 0.2rem 0 0;
		font-size: 14px;
		color: var(--text-secondary);
	}
	.period {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.bullets {
		max-width: var(--measure);
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.bullets li {
		position: relative;
		padding-left: 1.1rem;
		margin-bottom: 0.7rem;
		font-size: 15px;
		color: var(--text-secondary);
	}
	.bullets li::before {
		content: '▸';
		position: absolute;
		left: 0;
		color: var(--accent);
	}

	/* ---- Hunter Stats ---- */
	.stats-title {
		margin: 0 0 1.75rem;
		text-align: center;
		font-size: clamp(1.8rem, 5vw, 2.8rem);
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--accent);
		text-shadow: var(--text-glow);
	}
	.stats-title .br {
		color: var(--monarch);
		font-weight: 500;
	}
	/* Masonry via multi-column: each card is as tall as its list, so a short group
	   (Languages) ends early instead of stretching into an empty box. Columns fill
	   top-to-bottom, so order reads down then across. */
	.stat-grid {
		columns: 22rem 2;
		column-gap: 1.5rem;
	}
	.stat-card {
		break-inside: avoid;
		margin-bottom: 1.5rem;
	}
	.stat-card h3 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0 0 1.25rem;
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--monarch);
	}
	.kanji {
		font-family: serif;
		font-size: 1.6rem;
		font-weight: 400;
		letter-spacing: 0;
		color: rgba(76, 201, 255, 0.4);
	}
	.stat-card ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* name | rank | bar. Unranked items just take the first column. */
	.stat-card li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 1.5rem 38%;
		align-items: center;
		gap: 0.75rem;
		padding: 0.45rem 0;
	}
	.stat-card .name {
		font-family: var(--font-mono);
		font-size: 14px;
		letter-spacing: 0.04em;
		color: var(--text-primary);
	}
	.rank {
		font-family: var(--font-display);
		font-weight: 700;
		text-align: center;
	}
	.r-S { color: #ffd34d; text-shadow: 0 0 10px rgba(255, 211, 77, 0.6); }
	.r-A { color: var(--accent); }
	.r-B,
	.r-C,
	.r-D,
	.r-E { color: var(--monarch); }
	/* The global .bar, recoloured cyan-to-purple and unmargined for the row. */
	.stat-card .bar {
		margin: 0;
	}
	.stat-card .bar::before {
		background: linear-gradient(90deg, var(--accent), var(--monarch));
	}

	ul.plain {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul.plain li {
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
		font-size: 15px;
		color: var(--text-secondary);
	}
	ul.plain li:last-child {
		border-bottom: none;
	}
	ul.links li {
		font-size: 14px;
	}
</style>
