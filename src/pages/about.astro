---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/site';

// Roles come from src/content/experience/*.md, one file per role, sorted by their
// `order` field. Everything else on this page comes from src/content/pages/about.md
// — education, skills and certificates from its frontmatter, the narrative from
// its body.
const site = await getSite();

const pages = await getCollection('pages');
const about = pages.find((p) => p.id === 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
const { heading, lede, description, education, skills = [], certificates = [] } = about.data;

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${site.title}`} description={description ?? site.description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>{heading}</h1>
				<p class="lede">{lede}</p>
				<div class="prose-body"><Content /></div>
			</div>

			{
				roles.length > 0 && (
					<section class="block">
						<h2 class="section-label">Experience</h2>
						<ol class="roles">
							{roles.map((role) => (
								<li class="role">
									<div class="role-head">
										<div>
											<h3>{role.data.title}</h3>
											<p class="org">
												{role.data.org} · {role.data.location}
											</p>
										</div>
										<span class="period">{role.data.period}</span>
									</div>
									<ul class="bullets">
										{role.data.bullets.map((b) => (
											<li>{b}</li>
										))}
									</ul>
								</li>
							))}
						</ol>
					</section>
				)
			}

			{
				education && (
					<section class="block">
						<h2 class="section-label">Education</h2>
						<div class="role-head">
							<div>
								<h3>{education.degree}</h3>
								<p class="org">{education.school}</p>
							</div>
							<span class="period">{education.period}</span>
						</div>
					</section>
				)
			}

			{
				skills.length > 0 && (
					<section class="block">
						<h2 class="section-label">Skills</h2>
						<dl class="skills">
							{skills.map((s) => (
								<div class="skill-row">
									<dt>{s.group}</dt>
									<dd>{s.items}</dd>
								</div>
							))}
						</dl>
					</section>
				)
			}

			{
				certificates.length > 0 && (
					<section class="block">
						<h2 class="section-label">Certificates</h2>
						<ul class="plain">
							{certificates.map((c) => (
								<li>{c}</li>
							))}
						</ul>
					</section>
				)
			}

			<section class="block">
				<h2 class="section-label">Elsewhere</h2>
				<ul class="plain links">
					<li>
						<a href={site.github} target="_blank" rel="noopener">GitHub ↗</a>
					</li>
					<li>
						<a href={site.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
					</li>
					<li>
						<a href="https://huggingface.co/srijanratrey" target="_blank" rel="noopener">
							Hugging Face ↗
						</a>
					</li>
					<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede {
		font-size: 19px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin-top: 1.25rem;
	}

	/* Markdown body from about.md. :global because <Content /> output isn't scoped. */
	.prose-body :global(p) {
		margin-bottom: 1em;
	}
	.prose-body :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Each block's rule runs the full container while its prose stops at --measure. */
	.block {
		margin-top: 3.5rem;
	}
	.section-label {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		padding-bottom: 0.5rem;
		margin-bottom: 0;
		border-bottom: 2px solid var(--rule-strong);
	}

	.roles {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.role {
		padding: 2rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.roles > li:last-child {
		border-bottom: none;
	}
	.role-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding: 1.5rem 0 0;
	}
	.role .role-head {
		padding-top: 0;
	}
	.role-head h3 {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	.org {
		margin: 0.2rem 0 0;
		font-size: 14px;
		color: var(--text-secondary);
	}
	.period {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}

	.bullets {
		max-width: var(--measure);
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}
	.bullets li {
		position: relative;
		padding-left: 1.1rem;
		margin-bottom: 0.7rem;
		font-size: 15px;
		color: var(--text-secondary);
	}
	/* A rule, not a bullet glyph. */
	.bullets li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 0.6rem;
		height: 1px;
		background: var(--rule-strong);
	}

	.skills {
		margin: 0;
	}
	.skill-row {
		display: grid;
		grid-template-columns: minmax(0, 10rem) minmax(0, 1fr);
		gap: 0 1.5rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.skill-row:last-child {
		border-bottom: none;
	}
	.skills dt {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		padding-top: 0.2rem;
	}
	.skills dd {
		margin: 0;
		font-size: 15px;
		color: var(--text-secondary);
	}
	@media (max-width: 560px) {
		.skill-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.3rem;
		}
	}

	ul.plain {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	ul.plain li {
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
		font-size: 15px;
		color: var(--text-secondary);
	}
	ul.plain li:last-child {
		border-bottom: none;
	}
	ul.links li {
		font-size: 14px;
	}
</style>
