---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/site';

// All copy on this page comes from src/content/pages/home.md — the lede and metric
// row from its frontmatter, the paragraph below the metrics from its body.
const site = await getSite();
const pages = await getCollection('pages');
const home = pages.find((p) => p.id === 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
const { heading, lede, metrics = [], ctaLabel, ctaHref, writingHeading, allPostsLabel } = home.data;

// Mana bar width for a metric, only where the value is itself a proportion:
// "89.83%" -> 89.83, "0.684" -> 68.4, "23,936" -> no bar.
const barPct = (v: string) => {
	const n = parseFloat(v);
	if (v.trim().endsWith('%')) return n;
	return v.includes('.') && n >= 0 && n <= 1 ? n * 100 : undefined;
};

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={site.title} description={site.description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="sys notice" style="--i:0">
				<div class="sys-head"><span>! Notification</span><span class="dim">The System</span></div>
				<p>You have entered the portfolio of a Player. Proceed?</p>
			</div>

			<div class="measure">
				<h1 class="glitch" data-text={heading}>{heading}</h1>
				<p class="intro">{lede}</p>
			</div>

			{
				metrics.length > 0 && (
					<div class="sys status" style="--i:1">
						<div class="sys-head">
							<span>Status</span>
							<span class="dim">Stats</span>
						</div>
						<div class="metrics">
							{metrics.map((m) => (
								<div class="metric">
									<span class="metric-label">{m.label}</span>
									<span class:list={['metric-value', { 'is-trap': m.accent }]}>{m.value}</span>
									{barPct(m.value) !== undefined && (
										<span
											class:list={['bar', { monarch: m.accent }]}
											style={`--p:${barPct(m.value)}%`}
											aria-hidden="true"
										/>
									)}
								</div>
							))}
						</div>
					</div>
				)
			}

			<div class="measure prose-body">
				<Content />
				{ctaLabel && ctaHref && <p class="cta"><a href={ctaHref}>{ctaLabel}</a></p>}
			</div>

			{
				posts.length > 0 && <hr />
			}

			{
				posts.length > 0 && (
					<section class="sys recent" style="--i:2">
						<h2 class="sys-head">
							<span>{writingHeading ?? 'Writing'}</span>
							<span class="dim">Quest log</span>
						</h2>
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
						{allPostsLabel && (
							<p class="cta">
								<a href="/blog">{allPostsLabel}</a>
							</p>
						)}
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		font-size: 19px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin-top: 1.25rem;
	}

	.notice {
		max-width: 34rem;
		margin-bottom: 2.5rem;
		padding: 1rem 1.25rem;
	}
	.notice p {
		margin: 0;
		color: var(--text-secondary);
	}

	.status {
		margin: 2.5rem 0;
	}
	.metrics {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
		gap: 1.5rem;
	}
	.metric {
		border-left: 2px solid var(--accent-quiet);
		padding-left: 0.85rem;
	}
	.metric-label {
		display: block;
		font-family: var(--font-display);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.metric-value {
		display: block;
		font-family: var(--font-display);
		font-size: 2.4rem;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
		color: var(--text-primary);
		text-shadow: var(--text-glow);
		line-height: 1.1;
	}
	/* The one hook number per page — Shadow Monarch purple. */
	.metric:has(.is-trap) {
		border-left-color: var(--monarch);
	}
	.metric-value.is-trap {
		color: var(--monarch);
		text-shadow:
			0 0 10px rgba(180, 140, 255, 0.8),
			0 0 30px rgba(180, 140, 255, 0.4);
	}

	/* Markdown body from home.md. :global because <Content /> output isn't scoped. */
	.prose-body :global(p) {
		margin-bottom: 1em;
	}
	.prose-body :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.recent {
		margin-top: 4rem;
	}
	.recent ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.recent li:last-child {
		border-bottom: none;
	}
	.recent li a {
		color: var(--text-primary);
		text-decoration: none;
	}
	.recent li a::before {
		content: '▸ ';
		color: var(--accent);
	}
	.recent li a:hover {
		color: var(--accent);
	}
	.recent .date {
		color: var(--text-muted);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.cta {
		margin-top: 1.5rem;
		font-family: var(--font-display);
		font-size: 15px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.prose-body .cta :global(a) {
		text-decoration: none;
	}
</style>
