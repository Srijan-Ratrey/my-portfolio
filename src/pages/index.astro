---
import { getCollection, render } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/site';

// All copy on this page comes from src/content/pages/home.md — the lede and metric
// row from its frontmatter, the paragraph below the metrics from its body.
const site = await getSite();
const pages = await getCollection('pages');
const home = pages.find((p) => p.id === 'home');
if (!home) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(home);
const { heading, lede, metrics = [], ctaLabel, ctaHref, writingHeading, allPostsLabel } = home.data;

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={site.title} description={site.description} />
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>{heading}</h1>
				<p class="intro">{lede}</p>
			</div>

			{
				metrics.length > 0 && (
					<div class="metrics">
						{metrics.map((m) => (
							<div class="metric">
								<span class="metric-label">{m.label}</span>
								<span class:list={['metric-value', { 'is-trap': m.accent }]}>{m.value}</span>
							</div>
						))}
					</div>
				)
			}

			<div class="measure prose-body">
				<Content />
				{ctaLabel && ctaHref && <p class="cta"><a href={ctaHref}>{ctaLabel}</a></p>}
			</div>

			{
				posts.length > 0 && (
					<section class="recent">
						<h2>{writingHeading ?? 'Writing'}</h2>
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
						{allPostsLabel && (
							<p class="cta">
								<a href="/blog">{allPostsLabel}</a>
							</p>
						)}
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		font-size: 19px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin-top: 1.25rem;
	}

	/* Left-border cells, no radius — single-sided borders and rounded corners
	   never mix. */
	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 2.5rem 0;
	}
	.metric {
		border-left: 2px solid var(--rule-strong);
		padding-left: 0.75rem;
	}
	.metric-label {
		display: block;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.metric-value {
		display: block;
		font-size: 1.75rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		color: var(--text-primary);
		line-height: 1.2;
	}
	/* The one hook number per page that earns the accent. */
	.metric-value.is-trap {
		color: var(--accent);
	}

	/* Markdown body from home.md. :global because <Content /> output isn't scoped. */
	.prose-body :global(p) {
		margin-bottom: 1em;
	}
	.prose-body :global(a) {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* Deliberately not capped at --measure: the rules run the full container width
	   while the prose above stops short. That contrast is the point. */
	.recent {
		margin-top: 4rem;
	}
	.recent h2 {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--rule-strong);
	}
	.recent ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.recent li a {
		color: var(--text-primary);
		text-decoration: none;
	}
	.recent li a:hover {
		color: var(--accent);
	}
	.recent .date {
		color: var(--text-muted);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.cta {
		margin-top: 1.5rem;
		font-size: 14px;
	}
</style>
