---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

// Every figure here is verifiable from the Jigsaw post. Nothing is invented —
// the other three projects have no published numbers, so they get none.
const metrics = [
	{ label: 'Macro-F1', value: '0.684' },
	{ label: 'Accuracy trap', value: '89.83%', isTrap: true },
	{ label: 'N test', value: '23,936' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>Srijan Ratrey</h1>
				<p class="intro">
					I build and evaluate ML systems — content safety classifiers, retrieval pipelines, and
					the measurement harnesses that tell you whether any of it actually works.
				</p>
			</div>

			<div class="metrics">
				{
					metrics.map((m) => (
						<div class="metric">
							<span class="metric-label">{m.label}</span>
							<span class:list={['metric-value', { 'is-trap': m.isTrap }]}>{m.value}</span>
						</div>
					))
				}
			</div>

			<div class="measure">
				<p>
					Most of what I find interesting sits in the gap between a model that scores well and a
					model that is useful. A classifier that predicts nothing at all can post 89.8% accuracy;
					a retrieval system can return confident citations for the wrong document. So the work I
					care about is choosing the metric, calibrating the operating point, and being specific
					about where a system fails.
				</p>
				<p class="cta"><a href="/projects">See what I've built →</a></p>
			</div>

			{
				posts.length > 0 && (
					<section class="recent">
						<h2>Writing</h2>
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))}
						</ul>
						<p class="cta"><a href="/blog">All posts →</a></p>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		font-size: 19px;
		line-height: 1.55;
		color: var(--text-secondary);
		margin-top: 1.25rem;
	}

	/* Left-border cells, no radius — single-sided borders and rounded corners
	   never mix. */
	.metrics {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 2.5rem 0;
	}
	.metric {
		border-left: 2px solid var(--rule-strong);
		padding-left: 0.75rem;
	}
	.metric-label {
		display: block;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
	}
	.metric-value {
		display: block;
		font-size: 1.75rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		color: var(--text-primary);
		line-height: 1.2;
	}
	/* The one hook number per page that earns the accent. */
	.metric-value.is-trap {
		color: var(--accent);
	}

	/* Deliberately not capped at --measure: the rules run the full container width
	   while the prose above stops short. That contrast is the point. */
	.recent {
		margin-top: 4rem;
	}
	.recent h2 {
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--rule-strong);
	}
	.recent ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.recent li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 0;
		border-bottom: 1px solid var(--rule);
	}
	.recent li a {
		color: var(--text-primary);
		text-decoration: none;
	}
	.recent li a:hover {
		color: var(--accent);
	}
	.recent .date {
		color: var(--text-muted);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.cta {
		margin-top: 1.5rem;
		font-size: 14px;
	}
</style>
