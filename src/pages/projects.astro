---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSite } from '../lib/site';

// Cards come from src/content/projects/*.md — one file per project, sorted by
// their `order` field. Add a file to add a card; delete it to remove one.
const site = await getSite();
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const isExternal = (href: string) => href.startsWith('http');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${site.title}`}
			description="Content safety classification, retrieval, natural language to SQL, and a real-time multiplayer game on Cloudflare Workers."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>Projects</h1>
				<p class="lede">
					Things I've built, with the results and the limitations included. Every repo below is
					public.
				</p>
			</div>

			<ul class="projects">
				{
					projects.map((entry, i) => (
						<li class="project">
							<span class="index">{String(i + 1).padStart(2, '0')}</span>
							<h2>{entry.data.title}</h2>
							<p class="blurb">{entry.data.blurb}</p>
							<p class="detail">{entry.data.detail}</p>
							<ul class="stack">
								{entry.data.stack.map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
							<p class="links">
								{entry.data.links.map((link) => (
									<a
										href={link.href}
										class:list={[{ primary: link.primary }]}
										target={isExternal(link.href) ? '_blank' : undefined}
										rel={isExternal(link.href) ? 'noopener' : undefined}
									>
										{link.label}
										{isExternal(link.href) ? ' ↗' : ' →'}
									</a>
								))}
							</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede {
		color: var(--text-secondary);
		margin-bottom: 3rem;
	}
	ul.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		/* Full-bleed: the rules run to --page-max while the prose inside each entry
		   stops at --measure. */
		border-top: 2px solid var(--rule-strong);
	}
	.project {
		padding: 2rem 0;
		border-bottom: 1px solid var(--rule);
	}
	/* Numbered, mono, muted — the Swiss section index. */
	.index {
		display: block;
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		margin-bottom: 0.5rem;
	}
	.project h2 {
		margin: 0 0 0.6rem 0;
		font-size: 1.6rem;
		font-weight: 500;
		letter-spacing: -0.015em;
		max-width: var(--measure);
	}
	.blurb {
		margin: 0 0 0.7rem 0;
		color: var(--text-primary);
		max-width: var(--measure);
	}
	.detail {
		margin: 0 0 1.25rem 0;
		font-size: 14px;
		color: var(--text-secondary);
		max-width: var(--measure);
	}
	ul.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0 0 1.25rem 0;
		padding: 0;
	}
	/* Square, not pills — border-radius: 999px violates the aesthetic rules. */
	ul.stack li {
		padding: 0.2em 0.6em;
		border: 1px solid var(--rule);
		border-radius: 0;
		background: transparent;
		color: var(--text-secondary);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		/* Centred, not the default stretch: the outlined .primary below is taller than
		   the plain links, which would otherwise stretch and top-align their text. */
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		font-size: 13px;
	}
	/* The one link per card that is a thing you can do rather than a thing to read.
	   Every anchor on this site is already accent-coloured, so colour cannot mark this
	   out — and there are no buttons anywhere else. Hence the square 1px outline
	   borrowed from ul.stack above rather than a new shape. */
	.links a.primary {
		padding: 0.45em 0.9em;
		border: 1px solid var(--accent);
		border-radius: 0;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.links a.primary:hover {
		background: var(--accent);
		color: var(--surface-0);
	}
</style>
