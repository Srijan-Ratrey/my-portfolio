---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { byOrder, getSite } from '../lib/site';

// Cards come from src/content/projects/*.md — one file per project. Add a file to add
// a card; delete it to remove one. Ordering is the sparse `order` field; see byOrder.
const site = await getSite();
const projects = (await getCollection('projects')).sort(byOrder);

const isExternal = (href: string) => href.startsWith('http');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Projects | ${site.title}`}
			description="Content safety classification, retrieval, natural language to SQL, and a real-time multiplayer game on Cloudflare Workers."
		/>
	</head>
	<body>
		<Header />
		<main>
			<div class="measure">
				<h1>Projects</h1>
				<p class="lede">
					Things I've built, with the results and the limitations included. Every repo below is
					public.
				</p>
			</div>

			<ul class="projects">
				{
					projects.map((entry, i) => (
						<li class="sys project" style={`--i:${i}`} data-tilt>
							<div class="sys-head">
								<span>Quest {String(i + 1).padStart(2, '0')}</span>
								<span class="dim">Cleared</span>
							</div>
							<h2>{entry.data.title}</h2>
							<p class="blurb">{entry.data.blurb}</p>
							<p class="detail">{entry.data.detail}</p>
							<ul class="stack">
								{entry.data.stack.map((tech) => (
									<li>{tech}</li>
								))}
							</ul>
							<p class="links">
								{entry.data.links.map((link) => (
									<a
										href={link.href}
										class:list={[{ 'sys-btn': link.primary }]}
										target={isExternal(link.href) ? '_blank' : undefined}
										rel={isExternal(link.href) ? 'noopener' : undefined}
									>
										{link.label}
										{isExternal(link.href) ? ' ↗' : ' →'}
									</a>
								))}
							</p>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.lede {
		color: var(--text-secondary);
		margin-bottom: 3rem;
	}
	ul.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 2rem;
	}
	.project h2 {
		margin: 0 0 0.6rem 0;
		font-size: 1.9rem;
		font-weight: 700;
		letter-spacing: 0.01em;
		max-width: var(--measure);
	}
	.blurb {
		margin: 0 0 0.7rem 0;
		color: var(--text-primary);
		max-width: var(--measure);
	}
	.detail {
		margin: 0 0 1.25rem 0;
		font-size: 14px;
		color: var(--text-secondary);
		max-width: var(--measure);
	}
	ul.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0 0 1.25rem 0;
		padding: 0;
	}
	/* Skill tags. */
	ul.stack li {
		padding: 0.2em 0.6em;
		border: 1px solid var(--accent-quiet);
		background: rgba(76, 201, 255, 0.06);
		color: var(--accent);
		font-family: var(--font-display);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		/* Centred, not the default stretch: the .sys-btn primary link is taller than
		   the plain links, which would otherwise stretch and top-align their text. */
		align-items: center;
		gap: 1.5rem;
		margin: 0;
		font-size: 14px;
	}
</style>
